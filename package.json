{
  "name": "alphanex-exchange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev\" \"node server/index.js\"",
    "dev:web": "next dev",
    "dev:api": "node server/index.js",
    "build": "next build",
    "start": "concurrently -k -n web,api -c cyan,magenta \"next start\" \"node server/index.js\"",
    "lint": "next lint",
    "contracts:test": "npm --prefix contracts test",
    "contracts:deploy": "npm --prefix contracts run deploy:sepolia"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.11.2",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "siwe": "^3.0.0",
    "tailwind-merge": "^2.5.4",
    "viem": "^2.55.10",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17"
  }
}
